# Optional local configuration. Do not put real passwords, tokens, or API keys here.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_COOKIE_NAME=team_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
# AUTH_BOOTSTRAP_PASSWORD is intentionally omitted. Set it only in your shell for non-interactive account provisioning.

# Single-service production image defaults (Railway overrides PORT automatically).
# The production Dockerfile builds the frontend with an empty VITE_API_BASE_URL so browser API calls are same-origin.
# DATABASE_PATH=/app/data/.runtime/team-project.db
# FRONTEND_DIST_PATH=/app/frontend/dist
# PROJECTS_ROOT=/app/projects
# Mount persistent production storage at /app/data before relying on the database/source state.

# GitHub read-only contribution integration used by dashboards and project intelligence.
GITHUB_INTEGRATION_ENABLED=true
GITHUB_REPOSITORY=HoosseinRahimi/ForgeFlow-AI-Core
GITHUB_CACHE_TTL_SECONDS=60
GITHUB_API_TIMEOUT_SECONDS=5
# GITHUB_TOKEN is intentionally omitted. Public repositories work without it at lower rate limits.
# For private repositories or higher rate limits, export a fine-grained read-only token in the server environment.

# Controlled reviewed project runner. Disabled by default because it executes repository code.
PROJECT_RUNNER_ENABLED=false
PROJECT_RUNNER_TIMEOUT_SECONDS=5
PROJECT_RUNNER_OUTPUT_LIMIT=16000

# In-app AI provider. Local deterministic planning/diagnostics remain available without a key.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=20
AI_REQUESTS_PER_MINUTE=20
# AI_API_KEY is intentionally omitted. Export it only in the backend/server environment.

# Repository intelligence / lexical RAG safety bounds.
AI_RAG_MAX_FILE_BYTES=262144

# Recurring AI project-intelligence maintenance.
# The application default is enabled; set false explicitly if you do not want the maintenance loop.
AI_AUTOMATION_ENABLED=true
AI_AUTOMATION_INTERVAL_SECONDS=3600
# Automatic task mutation remains off by default. When false, progress can still be previewed manually.
AI_AUTOMATION_APPLY_PROGRESS=false

# Governed GitHub writes used only after propose -> approve -> execute.
# These are intentionally omitted as real credentials. Configure them only in the backend/server secret store.
AI_GITHUB_REPOSITORY=HoosseinRahimi/ForgeFlow-AI-Core
AI_GITHUB_TIMEOUT_SECONDS=15
# AI_GITHUB_TOKEN=<server-only fine-grained token>
