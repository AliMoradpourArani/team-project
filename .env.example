# Optional local configuration. Do not put real passwords or API keys here.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_COOKIE_NAME=team_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
# AUTH_BOOTSTRAP_PASSWORD is intentionally omitted. Set it only in your shell for non-interactive account provisioning.

# Phase 4 GitHub read-only integration.
GITHUB_INTEGRATION_ENABLED=true
GITHUB_REPOSITORY=HoosseinRahimi/team-project
GITHUB_CACHE_TTL_SECONDS=60
GITHUB_API_TIMEOUT_SECONDS=5
# GITHUB_TOKEN is intentionally omitted. Public repositories work without it at lower rate limits.
# For private repositories or higher rate limits, export a fine-grained read-only token in your shell.
